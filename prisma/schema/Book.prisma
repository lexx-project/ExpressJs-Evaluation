model Book {
    id String @id @default(uuid())
    title String 
    author String
    publishedYear Int
    stock Int
    isbn String @unique
    
    categoryId String
    category Category @relation(fields: [categoryId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    deletedAt DateTime?   

    @@map("books")
}